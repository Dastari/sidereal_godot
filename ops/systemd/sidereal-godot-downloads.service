[Unit]
Description=Sidereal native evaluation downloads (loopback, Tailscale HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
ExecStart=/usr/bin/python3 @PROJECT_ROOT@/scripts/dev.py godot-serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@PROJECT_ROOT@/.runtime

[Install]
WantedBy=multi-user.target
